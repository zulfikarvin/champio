# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase -> Project Settings -> API -> service_role.
# Bypasses RLS entirely. Server-side only; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The project ref alone (the subdomain above), used by `npm run db:types`.
SUPABASE_PROJECT_REF=your-project-ref

# Google AI Studio (https://aistudio.google.com/apikey). Required from Phase 2 —
# the evaluation pipeline will not run without it.
GEMINI_API_KEY=your-gemini-key

# Shared secret for /api/cron/sweep, which re-drives stuck evaluations.
# Any long random string; must match the CRON_SECRET repo secret used by
# .github/workflows/sweep.yml. Without it the endpoint refuses every request.
CRON_SECRET=generate-a-long-random-string

# Optional model overrides. Defaults are pinned in src/lib/ai/pricing.ts.
# Set these if a preview model is withdrawn — config change, not a redeploy.
# GEMINI_EVAL_MODEL=gemini-3.1-pro-preview
# GEMINI_FAST_MODEL=gemini-3.5-flash
